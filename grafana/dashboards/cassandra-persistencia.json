{
  "annotations": { "list": [] },
  "description": "Persistencia no Cassandra via metricas do Spring Data: vazao de operacoes, taxa de ingestao (saves), latencia media e erros.",
  "editable": true,
  "id": null,
  "uid": "timetrial-cassandra",
  "title": "Cassandra & Persistencia",
  "tags": ["time-trial", "cassandra"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Operacoes por segundo (por metodo do repositorio)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "sum by (method) (rate(spring_data_repository_invocations_seconds_count[1m]))", "legendFormat": "{{method}}", "range": true, "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Taxa de ingestao (saves por segundo)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "sum(rate(spring_data_repository_invocations_seconds_count{method=~\"save.*\"}[1m]))", "legendFormat": "saves/s", "range": true, "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latencia media por metodo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "sum by (method) (rate(spring_data_repository_invocations_seconds_sum[1m])) / sum by (method) (rate(spring_data_repository_invocations_seconds_count[1m]))", "legendFormat": "{{method}}", "range": true, "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Erros de persistencia (por segundo)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "sum by (method) (rate(spring_data_repository_invocations_seconds_count{state=\"ERROR\"}[1m]))", "legendFormat": "{{method}}", "range": true, "refId": "A" }
      ]
    }
  ]
}
